<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	app:cardCornerRadius="8dp"
	app:cardElevation="8dp">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@android:color/black">

		<TextureView
			android:id="@+id/floatTexture"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<org.wastaken.kotatsu.api21.booru.media.view.StepMovieView
			android:id="@+id/floatGifView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom"
			android:gravity="center"
			android:orientation="horizontal">

			<ImageButton
				android:id="@+id/floatButtonPlay"
				
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/play"
				app:srcCompat="@drawable/ic_play" />

			<ImageButton
				android:id="@+id/floatButtonExpand"
				
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/media_mode_fullscreen"
				app:srcCompat="@drawable/ic_expand" />

			<ImageButton
				android:id="@+id/floatButtonClose"
				
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/clear"
				app:srcCompat="@drawable/ic_clear_all" />

		</LinearLayout>

	</FrameLayout>

</com.google.android.material.card.MaterialCardView>
